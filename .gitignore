# Home clutter — do not track at repo root
/.local
/bin
/go
/src
/work
/Documents
/Desktop
/Downloads

# Allow portable trees under link/
!link/bin/
!link/bin/**
!link/.local/
!link/.local/**

# GNOME machine state
.config/dconf/

# Editor / shell noise if it ever lands under link/
**/.netrwhist
**/.DS_Store
